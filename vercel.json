{
  "functions": {
    "api/analyze.js": {
      "maxDuration": 60
    },
    "api/plan.js": {
      "maxDuration": 60
    },
    "api/progress.js": {
      "maxDuration": 60
    },
    "api/summarize.js": {
      "maxDuration": 60
    },
    "api/insights.js": {
      "maxDuration": 60
    },
    "api/vision.js": {
      "maxDuration": 60
    },
    "api/ask.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/app.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/app.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}